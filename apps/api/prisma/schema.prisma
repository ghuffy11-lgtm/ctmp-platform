// =============================================================================
// CTMP — Corporate Tender Management Platform
// Prisma Schema
//
// Generated from:
//   database/migrations/001_initial_schema.sql
//   database/migrations/002_schema_hardening.sql
//
// Conventions:
//   * All table names are snake_case; mapped with @@map().
//   * All column names are snake_case; mapped with @map().
//   * UUID primary keys use @db.Uuid().
//   * TEXT columns use @db.Text().
//   * VARCHAR(n) columns use @db.VarChar(n).
//   * TIMESTAMPTZ columns are DateTime.
//   * NUMERIC/DECIMAL columns are Decimal.
//   * BIGSERIAL PKs are Int with @default(autoincrement()).
//   * INET columns are stored as String (Prisma has no native inet type).
//   * JSONB columns are Json.
//   * CHAR(n) columns are mapped with @db.Char(n).
// =============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMS
// =============================================================================

enum TenderStatus {
  DRAFT
  INTERNAL_REVIEW
  APPROVED
  PUBLISHED
  CLARIFICATION_PERIOD
  SUBMISSION_CLOSED
  TECHNICAL_OPENING
  TECHNICAL_EVALUATION
  COMMERCIAL_SEALED
  COMMITTEE_COMMERCIAL_OPENING
  COMMERCIAL_EVALUATION
  AWARD_RECOMMENDATION
  AWARDED
  TENDER_CLOSED
  CANCELLED
  SUSPENDED
  ARCHIVED

  @@map("tender_status")
}

enum TenderVisibility {
  PUBLIC
  INVITATION_ONLY

  @@map("tender_visibility")
}

enum EnvelopeType {
  TECHNICAL
  COMMERCIAL

  @@map("envelope_type")
}

enum EnvelopeStatus {
  DRAFT
  SUBMITTED
  SEALED
  OPENED
  LOCKED

  @@map("envelope_status")
}

enum BidStatus {
  DRAFT
  SUBMITTED
  LATE_SUBMITTED
  LATE_ACCEPTED
  WITHDRAWN
  DISQUALIFIED
  EVALUATED
  AWARDED
  NOT_AWARDED

  @@map("bid_status")
}

enum TechnicalResult {
  PENDING
  PASS
  FAIL

  @@map("technical_result")
}

enum UserAuthType {
  AD
  LOCAL

  @@map("user_auth_type")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  BLACKLISTED

  @@map("vendor_status")
}

enum VendorRegistrationStatus {
  PENDING_VERIFICATION
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@map("vendor_registration_status")
}

enum LateExceptionStatus {
  PENDING_APPROVAL
  GRANTED
  REJECTED
  EXPIRED
  USED

  @@map("late_exception_status")
}

enum WorkflowSubjectType {
  TENDER_CREATION
  TENDER_PUBLISH
  TENDER_CANCEL
  LATE_SUBMISSION_EXCEPTION
  TECHNICAL_FINALIZE
  AWARD_RECOMMENDATION
  AWARD_FINALIZE

  @@map("workflow_subject_type")
}

enum WorkflowStepType {
  SEQUENTIAL
  PARALLEL

  @@map("workflow_step_type")
}

enum WorkflowInstanceStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED

  @@map("workflow_instance_status")
}

enum WorkflowTaskStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  EXPIRED

  @@map("workflow_task_status")
}

enum CommitteeSessionStatus {
  SCHEDULED
  IN_SESSION
  COMPLETED
  CANCELLED

  @@map("committee_session_status")
}

enum AuditRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("audit_risk_level")
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED

  @@map("notification_status")
}

enum CaptchaResult {
  SUCCESS
  FAILURE

  @@map("captcha_result")
}

enum ClarificationStatus {
  OPEN
  ANSWERED
  CLOSED

  @@map("clarification_status")
}

// =============================================================================
// ORGANIZATION
// =============================================================================

model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(255)
  parentId  String?  @map("parent_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  // Self-relation (hierarchy)
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentHierarchy")

  // Back-relations
  userDepartments UserDepartment[]
  tenders         Tender[]

  @@map("departments")
}

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adUsername   String?      @unique @map("ad_username") @db.VarChar(255)
  email        String       @unique @db.VarChar(255)
  displayName  String       @map("display_name") @db.VarChar(255)
  authType     UserAuthType @default(AD) @map("auth_type")
  passwordHash String?      @map("password_hash") @db.Text
  mfaEnabled    Boolean      @default(false) @map("mfa_enabled")
  mfaSecret     String?      @map("mfa_secret") @db.Text
  tokenVersion  Int          @default(0) @map("token_version")
  status        UserStatus   @default(ACTIVE)
  lastLoginAt   DateTime?    @map("last_login_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @map("updated_at")

  // Relations
  userDepartments         UserDepartment[]
  userRoles               UserRole[]                  @relation("UserRoleUser")
  grantedUserRoles        UserRole[]                  @relation("UserRoleGrantedBy")
  approvedVendors         Vendor[]                    @relation("VendorApprovedBy")
  reviewedRegistrations   VendorRegistrationRequest[] @relation("RegistrationReviewedBy")
  uploadedTenderDocuments TenderDocument[]
  invitedTenderVendors    TenderVendor[]
  askedClarifications     TenderClarification[]       @relation("ClarificationAskedByUser")
  clarificationReplies    TenderClarificationReply[]
  createdWorkflowTemplates WorkflowTemplate[]
  initiatedWorkflowInstances WorkflowInstance[]
  assignedWorkflowTasks    WorkflowTask[]              @relation("WorkflowTaskAssignee")
  completedWorkflowTasks   WorkflowTask[]              @relation("WorkflowTaskCompletedBy")
  approvalActions         ApprovalAction[]
  grantedLateExceptions   LateSubmissionException[]   @relation("LateExceptionGrantedBy")
  openedCommitteeSessions CommitteeSession[]          @relation("CommitteeSessionOpenedBy")
  createdCommitteeSessions CommitteeSession[]          @relation("CommitteeSessionCreatedBy")
  committeeMembers        CommitteeMember[]
  recordedAttendances     CommitteeAttendance[]
  openedBidEnvelopes      BidEnvelope[]
  recordedOpeningRecords  CommitteeOpeningRecord[]
  technicalEvaluations    TechnicalEvaluation[]
  commercialEvaluations   CommercialEvaluation[]
  generatedComparisons    CommercialComparison[]
  verifiedFileIntegrity   FileIntegrityCheck[]
  actorAuditLogs          AuditLog[]                  @relation("AuditLogActorUser")
  acknowledgedAlerts      SecurityAlert[]
  recipientNotificationLogs NotificationLog[]         @relation("NotificationLogRecipientUser")
  createdTenders          Tender[]                    @relation("TenderCreatedBy")
  ownedTenders            Tender[]                    @relation("TenderOwner")
  createdTenderVersions   TenderVersion[]
  changedVendorStatuses   VendorStatusHistory[]
  updatedSystemSettings   SystemSetting[]

  @@map("users")
}

model UserDepartment {
  userId       String   @map("user_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  isPrimary    Boolean  @default(false) @map("is_primary")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@map("user_departments")
}

// =============================================================================
// RBAC
// =============================================================================

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions  RolePermission[]
  userRoles        UserRole[]
  workflowSteps    WorkflowStep[]   @relation("WorkflowStepRequiredRole")
  assignedWorkflowTasks WorkflowTask[] @relation("WorkflowTaskAssigneeRole")

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(128)
  category    String   @db.VarChar(64)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  user      User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantor   User? @relation("UserRoleGrantedBy", fields: [grantedBy], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// =============================================================================
// CAPTCHA LOGS
// =============================================================================

model CaptchaVerificationLog {
  id           BigInt        @id @default(autoincrement())
  targetAction String        @map("target_action") @db.VarChar(64)
  provider     String?       @db.VarChar(64)
  ipAddress    String?       @map("ip_address") // INET stored as String
  userAgent    String?       @map("user_agent") @db.Text
  result       CaptchaResult
  score        Decimal?      @db.Decimal(4, 3)
  errorCode    String?       @map("error_code") @db.VarChar(128)
  verifiedAt   DateTime      @default(now()) @map("verified_at")

  vendorRegistrationRequests VendorRegistrationRequest[]

  @@map("captcha_verification_logs")
}

// =============================================================================
// VENDORS
// =============================================================================

model Vendor {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName        String       @map("company_name") @db.VarChar(255)
  registrationNumber String?      @map("registration_number") @db.VarChar(128)
  taxNumber          String?      @map("tax_number") @db.VarChar(128)
  country            String?      @db.Char(2)
  address            String?      @db.Text
  phone              String?      @db.VarChar(64)
  website            String?      @db.VarChar(255)
  status             VendorStatus @default(PENDING)
  blacklistReason    String?      @map("blacklist_reason") @db.Text
  suspensionReason   String?      @map("suspension_reason") @db.Text
  approvedBy         String?      @map("approved_by") @db.Uuid
  approvedAt         DateTime?    @map("approved_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @default(now()) @map("updated_at")

  approvedByUser          User?                       @relation("VendorApprovedBy", fields: [approvedBy], references: [id])
  vendorUsers             VendorUser[]
  vendorRegistrationRequests VendorRegistrationRequest[]
  vendorDocuments         VendorDocument[]
  vendorStatusHistory     VendorStatusHistory[]
  tenderVendors           TenderVendor[]
  tenderClarifications    TenderClarification[]
  bids                    Bid[]
  lateSubmissionExceptions LateSubmissionException[]
  awardedTenders          Tender[]                    @relation("TenderAwardedVendor")
  auditLogs               AuditLog[]                  @relation("AuditLogVendor")

  @@unique([companyName, registrationNumber])
  @@map("vendors")
}

model VendorUser {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId          String      @map("vendor_id") @db.Uuid
  email             String      @unique @db.VarChar(255)
  passwordHash      String      @map("password_hash") @db.Text
  fullName          String      @map("full_name") @db.VarChar(255)
  phone             String?     @db.VarChar(64)
  isPrimaryContact  Boolean     @default(false) @map("is_primary_contact")
  mfaEnabled        Boolean     @default(false) @map("mfa_enabled")
  mfaSecret         String?     @map("mfa_secret") @db.Text
  tokenVersion      Int         @default(0) @map("token_version")
  status            UserStatus  @default(ACTIVE)
  emailVerifiedAt   DateTime?   @map("email_verified_at")
  lastLoginAt       DateTime?   @map("last_login_at")
  failedLoginCount  Int         @default(0) @map("failed_login_count")
  lockedUntil       DateTime?   @map("locked_until")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @default(now()) @map("updated_at")

  vendor                        Vendor                        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  emailVerificationTokens       VendorEmailVerificationToken[]
  passwordResetTokens           VendorPasswordResetToken[]
  uploadedVendorDocuments       VendorDocument[]
  submittedBids                 Bid[]
  bidSubmissionReceipts         BidSubmissionReceipt[]
  askedClarifications           TenderClarification[]         @relation("ClarificationAskedByVendorUser")
  actorAuditLogs                AuditLog[]                    @relation("AuditLogActorVendorUser")
  recipientNotificationLogs     NotificationLog[]             @relation("NotificationLogRecipientVendorUser")

  @@map("vendor_users")
}

model VendorRegistrationRequest {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId                String?                  @map("vendor_id") @db.Uuid
  companyName             String                   @map("company_name") @db.VarChar(255)
  registrationNumber      String?                  @map("registration_number") @db.VarChar(128)
  contactEmail            String                   @map("contact_email") @db.VarChar(255)
  contactName             String?                  @map("contact_name") @db.VarChar(255)
  /// NULL for admin-created/imported registrations only. Public self-registration endpoint must validate CAPTCHA server-side, insert a captcha_verification_logs row, and supply this FK before INSERT.
  captchaVerificationId   BigInt?                  @map("captcha_verification_id")
  submittedIp             String?                  @map("submitted_ip") // INET stored as String
  submittedUserAgent      String?                  @map("submitted_user_agent") @db.Text
  status                  VendorRegistrationStatus @default(PENDING_VERIFICATION)
  rejectionReason         String?                  @map("rejection_reason") @db.Text
  reviewedBy              String?                  @map("reviewed_by") @db.Uuid
  reviewedAt              DateTime?                @map("reviewed_at")
  submittedAt             DateTime                 @default(now()) @map("submitted_at")

  vendor                  Vendor?                  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  captchaVerificationLog  CaptchaVerificationLog?  @relation(fields: [captchaVerificationId], references: [id])
  reviewedByUser          User?                    @relation("RegistrationReviewedBy", fields: [reviewedBy], references: [id])

  @@map("vendor_registration_requests")
}

model VendorEmailVerificationToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorUserId String    @map("vendor_user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Text
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  vendorUser VendorUser @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)

  @@map("vendor_email_verification_tokens")
}

model VendorPasswordResetToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorUserId      String    @map("vendor_user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Text
  expiresAt         DateTime  @map("expires_at")
  usedAt            DateTime? @map("used_at")
  requestIp         String?   @map("request_ip") // INET stored as String
  requestUserAgent  String?   @map("request_user_agent") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")

  vendorUser VendorUser @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)

  @@map("vendor_password_reset_tokens")
}

model VendorDocument {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId                 String    @map("vendor_id") @db.Uuid
  documentType             String    @map("document_type") @db.VarChar(64)
  originalFilename         String    @map("original_filename") @db.VarChar(255)
  storageKey               String    @map("storage_key") @db.Text
  mimeType                 String    @map("mime_type") @db.VarChar(128)
  fileSize                 BigInt    @map("file_size")
  checksumSha256           String    @map("checksum_sha256") @db.Char(64)
  expiryDate               DateTime? @map("expiry_date") @db.Date
  uploadedByVendorUserId   String?   @map("uploaded_by_vendor_user_id") @db.Uuid
  uploadedAt               DateTime  @default(now()) @map("uploaded_at")

  vendor         Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  uploadedByUser VendorUser? @relation(fields: [uploadedByVendorUserId], references: [id])

  @@map("vendor_documents")
}

model VendorStatusHistory {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId  String       @map("vendor_id") @db.Uuid
  oldStatus VendorStatus? @map("old_status")
  newStatus VendorStatus @map("new_status")
  reason    String?      @db.Text
  changedBy String?      @map("changed_by") @db.Uuid
  changedAt DateTime     @default(now()) @map("changed_at")

  vendor        Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  changedByUser User?  @relation(fields: [changedBy], references: [id])

  @@map("vendor_status_history")
}

// =============================================================================
// TENDERS
// =============================================================================

model Tender {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference             String           @unique @db.VarChar(64)
  title                 String           @db.VarChar(255)
  summary               String?          @db.Text
  description           String?          @db.Text
  departmentId          String           @map("department_id") @db.Uuid
  category              String?          @db.VarChar(128)
  tenderType            String?          @map("tender_type") @db.VarChar(64)
  budgetEstimate        Decimal?         @map("budget_estimate") @db.Decimal(15, 2)
  currency              String?          @db.Char(3)
  visibility            TenderVisibility @default(PUBLIC)
  status                TenderStatus     @default(DRAFT)
  submissionOpenAt      DateTime?        @map("submission_open_at")
  submissionCloseAt     DateTime?        @map("submission_close_at")
  clarificationCloseAt  DateTime?        @map("clarification_close_at")
  technicalOpeningAt    DateTime?        @map("technical_opening_at")
  awardedAt             DateTime?        @map("awarded_at")
  awardedVendorId       String?          @map("awarded_vendor_id") @db.Uuid
  awardedAmount         Decimal?         @map("awarded_amount") @db.Decimal(15, 2)
  currentVersion        Int              @default(1) @map("current_version")
  createdBy             String           @map("created_by") @db.Uuid
  owningUserId          String?          @map("owning_user_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @default(now()) @map("updated_at")

  department            Department              @relation(fields: [departmentId], references: [id])
  createdByUser         User                    @relation("TenderCreatedBy", fields: [createdBy], references: [id])
  owningUser            User?                   @relation("TenderOwner", fields: [owningUserId], references: [id])
  awardedVendor         Vendor?                 @relation("TenderAwardedVendor", fields: [awardedVendorId], references: [id])
  tenderVersions        TenderVersion[]
  tenderDocuments       TenderDocument[]
  tenderVendors         TenderVendor[]
  tenderClarifications  TenderClarification[]
  lateSubmissionExceptions LateSubmissionException[]
  committeeSessions     CommitteeSession[]
  bids                  Bid[]
  commercialComparisons CommercialComparison[]
  auditLogs             AuditLog[]              @relation("AuditLogTender")
  notificationLogs      NotificationLog[]       @relation("NotificationLogTender")

  @@map("tenders")
}

model TenderVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenderId      String   @map("tender_id") @db.Uuid
  versionNumber Int      @map("version_number")
  snapshot      Json
  changeSummary String?  @map("change_summary") @db.Text
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  tender        Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  createdByUser User   @relation(fields: [createdBy], references: [id])

  @@unique([tenderId, versionNumber])
  @@map("tender_versions")
}

model TenderDocument {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenderId         String   @map("tender_id") @db.Uuid
  originalFilename String   @map("original_filename") @db.VarChar(255)
  storageKey       String   @map("storage_key") @db.Text
  mimeType         String   @map("mime_type") @db.VarChar(128)
  fileSize         BigInt   @map("file_size")
  checksumSha256   String   @map("checksum_sha256") @db.Char(64)
  isPublic         Boolean  @default(true) @map("is_public")
  uploadedBy       String   @map("uploaded_by") @db.Uuid
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  uploadedByUser User   @relation(fields: [uploadedBy], references: [id])

  @@map("tender_documents")
}

model TenderVendor {
  tenderId   String   @map("tender_id") @db.Uuid
  vendorId   String   @map("vendor_id") @db.Uuid
  invitedBy  String?  @map("invited_by") @db.Uuid
  invitedAt  DateTime @default(now()) @map("invited_at")

  tender          Tender  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendor          Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invitedByUser   User?   @relation(fields: [invitedBy], references: [id])

  @@id([tenderId, vendorId])
  @@map("tender_vendors")
}

model TenderClarification {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenderId              String              @map("tender_id") @db.Uuid
  vendorId              String?             @map("vendor_id") @db.Uuid
  askedByUserId         String?             @map("asked_by_user_id") @db.Uuid
  askedByVendorUserId   String?             @map("asked_by_vendor_user_id") @db.Uuid
  question              String              @db.Text
  isPublic              Boolean             @default(false) @map("is_public")
  status                ClarificationStatus @default(OPEN)
  createdAt             DateTime            @default(now()) @map("created_at")

  tender                Tender                     @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendor                Vendor?                    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  askedByUser           User?                      @relation("ClarificationAskedByUser", fields: [askedByUserId], references: [id])
  askedByVendorUser     VendorUser?                @relation("ClarificationAskedByVendorUser", fields: [askedByVendorUserId], references: [id])
  replies               TenderClarificationReply[]

  @@map("tender_clarifications")
}

model TenderClarificationReply {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clarificationId  String   @map("clarification_id") @db.Uuid
  repliedByUserId  String   @map("replied_by_user_id") @db.Uuid
  answer           String   @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  clarification  TenderClarification @relation(fields: [clarificationId], references: [id], onDelete: Cascade)
  repliedByUser  User                @relation(fields: [repliedByUserId], references: [id])

  @@map("tender_clarification_replies")
}

// =============================================================================
// WORKFLOW
// =============================================================================

model WorkflowTemplate {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String              @unique @db.VarChar(64)
  name        String              @db.VarChar(255)
  description String?             @db.Text
  subjectType WorkflowSubjectType @map("subject_type")
  isActive    Boolean             @default(true) @map("is_active")
  createdBy   String?             @map("created_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @default(now()) @map("updated_at")

  createdByUser      User?               @relation(fields: [createdBy], references: [id])
  workflowSteps      WorkflowStep[]
  workflowInstances  WorkflowInstance[]

  @@map("workflow_templates")
}

model WorkflowStep {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId               String           @map("template_id") @db.Uuid
  sequence                 Int
  stepType                 WorkflowStepType @default(SEQUENTIAL) @map("step_type")
  requiredRoleId           String?          @map("required_role_id") @db.Uuid
  requiredPermissionCode   String?          @map("required_permission_code") @db.VarChar(128)
  minApprovers             Int              @default(1) @map("min_approvers")
  requiresRejectionComment Boolean          @default(true) @map("requires_rejection_comment")

  template      WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  requiredRole  Role?            @relation("WorkflowStepRequiredRole", fields: [requiredRoleId], references: [id])
  workflowTasks WorkflowTask[]

  @@unique([templateId, sequence])
  @@map("workflow_steps")
}

model WorkflowInstance {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String                 @map("template_id") @db.Uuid
  subjectType WorkflowSubjectType    @map("subject_type")
  subjectId   String                 @map("subject_id") @db.Uuid
  status      WorkflowInstanceStatus @default(PENDING)
  currentStep Int                    @default(1) @map("current_step")
  initiatedBy String                 @map("initiated_by") @db.Uuid
  initiatedAt DateTime               @default(now()) @map("initiated_at")
  completedAt DateTime?              @map("completed_at")

  template                 WorkflowTemplate          @relation(fields: [templateId], references: [id])
  initiatedByUser          User                      @relation(fields: [initiatedBy], references: [id])
  workflowTasks            WorkflowTask[]
  lateSubmissionExceptions LateSubmissionException[]

  @@map("workflow_instances")
}

model WorkflowTask {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId      String             @map("instance_id") @db.Uuid
  stepId          String             @map("step_id") @db.Uuid
  assigneeUserId  String?            @map("assignee_user_id") @db.Uuid
  assigneeRoleId  String?            @map("assignee_role_id") @db.Uuid
  status          WorkflowTaskStatus @default(PENDING)
  comments        String?            @db.Text
  completedBy     String?            @map("completed_by") @db.Uuid
  completedAt     DateTime?          @map("completed_at")
  createdAt       DateTime           @default(now()) @map("created_at")

  instance          WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  step              WorkflowStep     @relation(fields: [stepId], references: [id])
  assigneeUser      User?            @relation("WorkflowTaskAssignee", fields: [assigneeUserId], references: [id])
  assigneeRole      Role?            @relation("WorkflowTaskAssigneeRole", fields: [assigneeRoleId], references: [id])
  completedByUser   User?            @relation("WorkflowTaskCompletedBy", fields: [completedBy], references: [id])
  approvalActions   ApprovalAction[]

  @@map("workflow_tasks")
}

model ApprovalAction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(32)
  comments    String?  @db.Text
  actionAt    DateTime @default(now()) @map("action_at")

  task      WorkflowTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorUser User         @relation(fields: [actorUserId], references: [id])

  @@map("approval_actions")
}

// =============================================================================
// LATE SUBMISSION EXCEPTIONS
// =============================================================================

model LateSubmissionException {
  id                           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenderId                     String              @map("tender_id") @db.Uuid
  vendorId                     String              @map("vendor_id") @db.Uuid
  grantedBy                    String?             @map("granted_by") @db.Uuid
  grantedAt                    DateTime?           @map("granted_at")
  reason                       String              @db.Text
  expiresAt                    DateTime            @map("expires_at")
  status                       LateExceptionStatus @default(PENDING_APPROVAL)
  approvalWorkflowInstanceId   String?             @map("approval_workflow_instance_id") @db.Uuid
  /// Not a strict FK — intentionally loose so audit logs cannot be cascade-deleted by exception cleanup.
  auditLogId                   BigInt?             @map("audit_log_id")
  createdAt                    DateTime            @default(now()) @map("created_at")
  updatedAt                    DateTime            @default(now()) @map("updated_at")

  tender                   Tender           @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendor                   Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  grantedByUser            User?            @relation("LateExceptionGrantedBy", fields: [grantedBy], references: [id])
  approvalWorkflowInstance WorkflowInstance? @relation(fields: [approvalWorkflowInstanceId], references: [id])
  bids                     Bid[]

  @@map("late_submission_exceptions")
}

// =============================================================================
// COMMITTEE SESSIONS
// =============================================================================

model CommitteeSession {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenderId    String                 @map("tender_id") @db.Uuid
  scheduledAt DateTime               @map("scheduled_at")
  location    String?                @db.VarChar(255)
  status      CommitteeSessionStatus @default(SCHEDULED)
  openedBy    String?                @map("opened_by") @db.Uuid
  openedAt    DateTime?              @map("opened_at")
  minutesText String?                @map("minutes_text") @db.Text
  createdBy   String                 @map("created_by") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @default(now()) @map("updated_at")

  tender           Tender                    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  openedByUser     User?                     @relation("CommitteeSessionOpenedBy", fields: [openedBy], references: [id])
  createdByUser    User                      @relation("CommitteeSessionCreatedBy", fields: [createdBy], references: [id])
  committeeMembers CommitteeMember[]
  committeeAttendances CommitteeAttendance[]
  bidEnvelopes     BidEnvelope[]
  openingRecords   CommitteeOpeningRecord[]

  @@map("committee_sessions")
}

model CommitteeMember {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  roleInCommittee String?  @map("role_in_committee") @db.VarChar(64)
  isChair         Boolean  @default(false) @map("is_chair")
  addedAt         DateTime @default(now()) @map("added_at")

  session      CommitteeSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id])
  attendances  CommitteeAttendance[]

  @@unique([sessionId, userId])
  @@map("committee_members")
}

model CommitteeAttendance {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  present    Boolean
  remarks    String?  @db.Text
  recordedBy String   @map("recorded_by") @db.Uuid
  recordedAt DateTime @default(now()) @map("recorded_at")

  session      CommitteeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member       CommitteeMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedByUser User           @relation(fields: [recordedBy], references: [id])

  @@unique([sessionId, memberId])
  @@map("committee_attendance")
}

// =============================================================================
// BIDS AND ENVELOPES
// =============================================================================

model Bid {
  id                        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenderId                  String          @map("tender_id") @db.Uuid
  vendorId                  String          @map("vendor_id") @db.Uuid
  status                    BidStatus       @default(DRAFT)
  submittedAt               DateTime?       @map("submitted_at")
  submittedByVendorUserId   String?         @map("submitted_by_vendor_user_id") @db.Uuid
  withdrawnAt               DateTime?       @map("withdrawn_at")
  technicalResult           TechnicalResult @default(PENDING) @map("technical_result")
  lateExceptionId           String?         @map("late_exception_id") @db.Uuid
  isAlternative             Boolean         @default(false) @map("is_alternative")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @default(now()) @map("updated_at")

  tender                  Tender                  @relation(fields: [tenderId], references: [id])
  vendor                  Vendor                  @relation(fields: [vendorId], references: [id])
  submittedByVendorUser   VendorUser?             @relation(fields: [submittedByVendorUserId], references: [id])
  lateException           LateSubmissionException? @relation(fields: [lateExceptionId], references: [id])
  bidEnvelopes            BidEnvelope[]
  bidSubmissionReceipt    BidSubmissionReceipt?
  technicalEvaluations    TechnicalEvaluation[]
  commercialEvaluations   CommercialEvaluation[]
  auditLogs               AuditLog[]              @relation("AuditLogBid")

  @@unique([tenderId, vendorId, isAlternative])
  @@map("bids")
}

model BidEnvelope {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bidId              String         @map("bid_id") @db.Uuid
  envelopeType       EnvelopeType   @map("envelope_type")
  status             EnvelopeStatus @default(DRAFT)
  submittedAt        DateTime?      @map("submitted_at")
  openedAt           DateTime?      @map("opened_at")
  openedByUserId     String?        @map("opened_by_user_id") @db.Uuid
  committeeSessionId String?        @map("committee_session_id") @db.Uuid
  hashVerifiedAt     DateTime?      @map("hash_verified_at")
  lockedAt           DateTime?      @map("locked_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @default(now()) @map("updated_at")

  bid               Bid                      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  openedByUser      User?                    @relation(fields: [openedByUserId], references: [id])
  committeeSession  CommitteeSession?        @relation(fields: [committeeSessionId], references: [id])
  bidDocuments      BidDocument[]
  openingRecords    CommitteeOpeningRecord[]

  @@unique([bidId, envelopeType])
  @@map("bid_envelopes")
}

model BidDocument {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bidEnvelopeId    String    @map("bid_envelope_id") @db.Uuid
  originalFilename String    @map("original_filename") @db.VarChar(255)
  storageKey       String    @map("storage_key") @db.Text
  mimeType         String    @map("mime_type") @db.VarChar(128)
  fileSize         BigInt    @map("file_size")
  checksumSha256   String    @map("checksum_sha256") @db.Char(64)
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  submittedAt      DateTime? @map("submitted_at")
  lockedAt         DateTime? @map("locked_at")

  bidEnvelope     BidEnvelope          @relation(fields: [bidEnvelopeId], references: [id], onDelete: Cascade)
  fileIntegrityChecks FileIntegrityCheck[]

  @@map("bid_documents")
}

model BidSubmissionReceipt {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bidId                       String   @unique @map("bid_id") @db.Uuid
  receiptNumber               String   @unique @map("receipt_number") @db.VarChar(64)
  generatedForVendorUserId    String?  @map("generated_for_vendor_user_id") @db.Uuid
  receiptHash                 String   @map("receipt_hash") @db.Char(64)
  snapshot                    Json
  generatedAt                 DateTime @default(now()) @map("generated_at")

  bid                      Bid         @relation(fields: [bidId], references: [id], onDelete: Cascade)
  generatedForVendorUser   VendorUser? @relation(fields: [generatedForVendorUserId], references: [id])

  @@map("bid_submission_receipts")
}

// =============================================================================
// COMMITTEE OPENING RECORDS
// =============================================================================

model CommitteeOpeningRecord {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId          String   @map("session_id") @db.Uuid
  bidEnvelopeId      String   @map("bid_envelope_id") @db.Uuid
  checksumVerified   Boolean  @map("checksum_verified")
  checksumVerifiedAt DateTime @default(now()) @map("checksum_verified_at")
  openingRemarks     String?  @map("opening_remarks") @db.Text
  recordedBy         String   @map("recorded_by") @db.Uuid
  recordedAt         DateTime @default(now()) @map("recorded_at")

  session        CommitteeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  bidEnvelope    BidEnvelope      @relation(fields: [bidEnvelopeId], references: [id])
  recordedByUser User             @relation(fields: [recordedBy], references: [id])

  @@unique([sessionId, bidEnvelopeId])
  @@map("committee_opening_records")
}

// =============================================================================
// EVALUATIONS
// =============================================================================

model TechnicalEvaluation {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bidId           String          @map("bid_id") @db.Uuid
  evaluatorUserId String          @map("evaluator_user_id") @db.Uuid
  overallScore    Decimal?        @map("overall_score") @db.Decimal(6, 2)
  result          TechnicalResult @default(PENDING)
  comments        String?         @db.Text
  finalizedAt     DateTime?       @map("finalized_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @map("updated_at")

  bid           Bid                        @relation(fields: [bidId], references: [id], onDelete: Cascade)
  evaluatorUser User                       @relation(fields: [evaluatorUserId], references: [id])
  scores        TechnicalEvaluationScore[]

  @@unique([bidId, evaluatorUserId])
  @@map("technical_evaluations")
}

model TechnicalEvaluationScore {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicalEvaluationId String  @map("technical_evaluation_id") @db.Uuid
  criterion             String  @db.VarChar(255)
  weight                Decimal @db.Decimal(6, 2)
  score                 Decimal @db.Decimal(6, 2)
  comments              String? @db.Text

  technicalEvaluation TechnicalEvaluation @relation(fields: [technicalEvaluationId], references: [id], onDelete: Cascade)

  @@map("technical_evaluation_scores")
}

model CommercialEvaluation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bidId           String   @map("bid_id") @db.Uuid
  evaluatorUserId String   @map("evaluator_user_id") @db.Uuid
  totalPrice      Decimal? @map("total_price") @db.Decimal(15, 2)
  currency        String?  @db.Char(3)
  score           Decimal? @db.Decimal(6, 2)
  comments        String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")

  bid           Bid  @relation(fields: [bidId], references: [id], onDelete: Cascade)
  evaluatorUser User @relation(fields: [evaluatorUserId], references: [id])

  @@unique([bidId, evaluatorUserId])
  @@map("commercial_evaluations")
}

model CommercialComparison {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenderId    String   @map("tender_id") @db.Uuid
  snapshot    Json
  generatedBy String   @map("generated_by") @db.Uuid
  generatedAt DateTime @default(now()) @map("generated_at")

  tender          Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  generatedByUser User   @relation(fields: [generatedBy], references: [id])

  @@map("commercial_comparisons")
}

// =============================================================================
// FILE INTEGRITY CHECKS
// =============================================================================

model FileIntegrityCheck {
  id               BigInt    @id @default(autoincrement())
  bidDocumentId    String?   @map("bid_document_id") @db.Uuid
  expectedChecksum String    @map("expected_checksum") @db.Char(64)
  actualChecksum   String    @map("actual_checksum") @db.Char(64)
  success          Boolean
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid
  context          String?   @db.VarChar(64)
  notes            String?   @db.Text
  verifiedAt       DateTime  @default(now()) @map("verified_at")

  bidDocument      BidDocument? @relation(fields: [bidDocumentId], references: [id], onDelete: Cascade)
  verifiedByUser   User?        @relation(fields: [verifiedByUserId], references: [id])

  @@map("file_integrity_checks")
}

// =============================================================================
// AUDIT LOG (APPEND-ONLY) AND SECURITY ALERTS
// =============================================================================

/// append-only, enforced by DB trigger
model AuditLog {
  // append-only, enforced by DB trigger
  id                   BigInt         @id @default(autoincrement())
  // append-only, enforced by DB trigger
  eventType            String         @map("event_type") @db.VarChar(128)
  // append-only, enforced by DB trigger
  actorUserId          String?        @map("actor_user_id") @db.Uuid
  // append-only, enforced by DB trigger
  actorVendorUserId    String?        @map("actor_vendor_user_id") @db.Uuid
  // append-only, enforced by DB trigger
  actorRoleCode        String?        @map("actor_role_code") @db.VarChar(64)
  // append-only, enforced by DB trigger
  entityType           String         @map("entity_type") @db.VarChar(64)
  // append-only, enforced by DB trigger
  entityId             String?        @map("entity_id") @db.Uuid
  // append-only, enforced by DB trigger
  tenderId             String?        @map("tender_id") @db.Uuid
  // append-only, enforced by DB trigger
  vendorId             String?        @map("vendor_id") @db.Uuid
  // append-only, enforced by DB trigger
  bidId                String?        @map("bid_id") @db.Uuid
  // append-only, enforced by DB trigger
  ipAddress            String?        @map("ip_address") // INET stored as String
  // append-only, enforced by DB trigger
  userAgent            String?        @map("user_agent") @db.Text
  // append-only, enforced by DB trigger
  beforeValue          Json?          @map("before_value")
  // append-only, enforced by DB trigger
  afterValue           Json?          @map("after_value")
  // append-only, enforced by DB trigger
  reason               String?        @db.Text
  // append-only, enforced by DB trigger
  metadata             Json?
  // append-only, enforced by DB trigger
  riskLevel            AuditRiskLevel @default(LOW) @map("risk_level")
  // append-only, enforced by DB trigger
  prevHashChainValue   String?        @map("prev_hash_chain_value") @db.Char(64)
  // append-only, enforced by DB trigger
  hashChainValue       String         @map("hash_chain_value") @db.Char(64)
  // append-only, enforced by DB trigger
  eventTime            DateTime       @default(now()) @map("event_time")

  actorUser        User?   @relation("AuditLogActorUser", fields: [actorUserId], references: [id])
  actorVendorUser  VendorUser? @relation("AuditLogActorVendorUser", fields: [actorVendorUserId], references: [id])
  tender           Tender?  @relation("AuditLogTender", fields: [tenderId], references: [id])
  vendor           Vendor?  @relation("AuditLogVendor", fields: [vendorId], references: [id])
  bid              Bid?     @relation("AuditLogBid", fields: [bidId], references: [id])

  @@map("audit_logs")
}

model SecurityAlert {
  id               BigInt         @id @default(autoincrement())
  alertType        String         @map("alert_type") @db.VarChar(64)
  severity         AuditRiskLevel @default(MEDIUM)
  sourceIp         String?        @map("source_ip") // INET stored as String
  targetEntityType String?        @map("target_entity_type") @db.VarChar(64)
  targetEntityId   String?        @map("target_entity_id") @db.Uuid
  message          String         @db.Text
  metadata         Json?
  acknowledgedBy   String?        @map("acknowledged_by") @db.Uuid
  acknowledgedAt   DateTime?      @map("acknowledged_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  acknowledgedByUser User? @relation(fields: [acknowledgedBy], references: [id])

  @@map("security_alerts")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model NotificationTemplate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique @db.VarChar(64)
  subjectTemplate String   @map("subject_template") @db.Text
  bodyTemplate    String   @map("body_template") @db.Text
  channel         String   @default("EMAIL") @db.VarChar(32)
  locale          String   @default("en") @db.VarChar(8)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")

  @@map("notification_templates")
}

model NotificationLog {
  id                     BigInt             @id @default(autoincrement())
  templateCode           String             @map("template_code") @db.VarChar(64)
  subject                String             @db.Text
  recipientEmail         String             @map("recipient_email") @db.VarChar(255)
  recipientUserId        String?            @map("recipient_user_id") @db.Uuid
  recipientVendorUserId  String?            @map("recipient_vendor_user_id") @db.Uuid
  tenderId               String?            @map("tender_id") @db.Uuid
  status                 NotificationStatus @default(QUEUED)
  error                  String?            @db.Text
  sentAt                 DateTime?          @map("sent_at")
  createdAt              DateTime           @default(now()) @map("created_at")

  recipientUser       User?       @relation("NotificationLogRecipientUser", fields: [recipientUserId], references: [id])
  recipientVendorUser VendorUser? @relation("NotificationLogRecipientVendorUser", fields: [recipientVendorUserId], references: [id])
  tender              Tender?     @relation("NotificationLogTender", fields: [tenderId], references: [id])

  @@map("notification_logs")
}

// =============================================================================
// SYSTEM SETTINGS
// =============================================================================

model SystemSetting {
  key         String   @id @db.VarChar(128)
  value       String?  @db.Text
  valueType   String   @default("string") @map("value_type") @db.VarChar(32)
  description String?  @db.Text
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at")

  updatedByUser User? @relation(fields: [updatedBy], references: [id])

  @@map("system_settings")
}
