# Copy to .env.local and fill in values

# Application
PORT=3000
API_PREFIX=api
NODE_ENV=development
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# Database
DATABASE_URL=postgresql://ctmp_user:changeme@localhost:5432/ctmp_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_VENDOR_SECRET=
JWT_VENDOR_EXPIRES_IN=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Active Directory (internal users)
AD_URL=ldap://dc.yourcompany.local
AD_BASE_DN=DC=yourcompany,DC=local
AD_BIND_DN=CN=svc-ctmp,OU=ServiceAccounts,DC=yourcompany,DC=local
AD_BIND_PASSWORD=
AD_DOMAIN=yourcompany.local

# Email / SMTP
SMTP_HOST=smtp.yourcompany.local
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourcompany.local

# CAPTCHA (vendor registration — required)
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
