# =============================================================================
# CTMP Docker Compose environment template
# Copy to .env in this directory and fill in values before running docker compose up.
# =============================================================================

# --- Database ---
POSTGRES_USER=ctmp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ctmp
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API ---
NODE_ENV=production
API_PORT=3000
JWT_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_long_random_string
VENDOR_JWT_SECRET=replace_with_long_random_string
VENDOR_JWT_REFRESH_SECRET=replace_with_long_random_string

# --- Active Directory (internal user auth) ---
AD_URL=ldap://ad.local:389
AD_BIND_DN=
AD_BIND_PASSWORD=

# --- SMTP (notifications) ---
# Default points at the mailhog container so dev/QA can read sent mail at http://localhost:8025.
# Replace with real SMTP host/port/credentials for production.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# --- CAPTCHA (vendor self-registration) ---
# Supported providers:
#   hcaptcha — production. Requires CAPTCHA_SECRET_KEY from your hCaptcha account.
#   stub     — dev/CI only. Accepts any non-empty, non-"invalid" token.
# The API refuses to start with provider=stub when NODE_ENV=production
# unless CAPTCHA_ALLOW_STUB_IN_PROD=true (escape hatch; NOT recommended).
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://hcaptcha.com/siteverify
CAPTCHA_VERIFY_TIMEOUT_MS=5000
CAPTCHA_ALLOW_STUB_IN_PROD=false
# Public site key — baked into the vendor portal at build time.
# Test key 10000000-ffff-ffff-ffff-000000000001 always issues tokens that the
# matching test secret 0x0000000000000000000000000000000000000000 accepts.
# Swap both to your real hcaptcha.com keys before production.
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# --- Report export worker (BullMQ on Redis) ---
REPORT_WORKER_ENABLED=true
REPORT_WORKER_CONCURRENCY=2
REPORT_QUEUE_NAME=ctmp-report-exports

# --- Bid document storage ---
BID_STORAGE_PATH=/data/bid-documents

# --- Storage backend (local | s3) ---
# `local` writes to named volumes. `s3` routes through MinIO (default) or external S3.
STORAGE_DRIVER=local
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=ctmpadmin
STORAGE_S3_SECRET_KEY=ctmpadmin_dev
STORAGE_S3_BUCKET_PREFIX=ctmp
STORAGE_S3_AUTO_CREATE_BUCKETS=true

# MinIO admin (sidecar). Console at http://localhost:9001 once compose is up.
MINIO_ROOT_USER=ctmpadmin
MINIO_ROOT_PASSWORD=ctmpadmin_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Audit chain verifier ---
# Recomputes SHA-256 over the last N audit rows on api boot. Logs success;
# emits a CRITICAL security_alerts row on chain break.
AUDIT_VERIFY_ON_START=true
AUDIT_VERIFY_LIMIT=1000

# --- Frontend → backend URL (used by web-admin and web-vendor) ---
PUBLIC_API_URL=http://api:3000

# --- Frontend ports ---
WEB_ADMIN_PORT=4200
WEB_VENDOR_PORT=4300

# --- Email link URLs (BUG-144) ---
# Absolute URLs embedded in every notification email (vendor invitations,
# evaluator notifications, password resets, etc.). MUST be the public hostname
# the recipient will click — not the internal docker network address.
# Defaults are the staging URLs; override when going live with a new host.
ADMIN_PORTAL_URL=https://ctmp-admin.hadiclinic.com.kw:4202
VENDOR_PORTAL_URL=https://vn.hadiclinic.com.kw:4201
