# =============================================================================
# CTMP PRODUCTION — vendor server (172.16.4.11) env template.
#
# Copy to `.env.vendor-prod` ON THE VENDOR HOST ONLY. Pass it on every compose
# call:  docker compose --env-file .env.vendor-prod \
#          -f docker-compose.vendor-prod.yml -p ctmp <build|up -d --no-build>
#
# The vendor host runs ONLY web-vendor + nginx; no DB/redis/api secrets here.
# Both values below are BUILD ARGS baked into the vendor bundle — changing them
# requires a web-vendor rebuild (on the egress box) + image re-transfer.
# =============================================================================

# Public origin the vendor browser uses (also where nginx proxies /api from).
VENDOR_PUBLIC_API_URL=https://vn.hadiclinic.com.kw:4201

# Published TLS port (container listens 443).
VENDOR_TLS_PORT=4201

# Org's real hCaptcha SITE key (public; baked into the registration page).
HCAPTCHA_SITE_KEY=b03031a4-dab0-431a-8744-bdc2d13af2a2
