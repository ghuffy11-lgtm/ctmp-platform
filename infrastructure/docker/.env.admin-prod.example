# =============================================================================
# CTMP PRODUCTION — admin server (10.1.27.99) env template.
#
# Copy to `.env.admin-prod` ON THE HOST ONLY and fill in. NEVER commit or rsync
# the filled file (see .gitignore). Pass it explicitly on every compose call:
#
#   docker compose --env-file .env.admin-prod \
#     -f docker-compose.admin-prod.yml -p ctmp <build|up -d>
#
# Generate each secret fresh — do NOT reuse staging values:
#   openssl rand -hex 32
# =============================================================================

# --- Core ---
NODE_ENV=production

# --- Database (internal only; not published to the host) ---
POSTGRES_USER=ctmp
POSTGRES_PASSWORD=__GENERATE__          # openssl rand -hex 32
POSTGRES_DB=ctmp

# --- JWT / refresh secrets (unique per environment) ---
JWT_SECRET=__GENERATE__                 # openssl rand -hex 32
JWT_REFRESH_SECRET=__GENERATE__
VENDOR_JWT_SECRET=__GENERATE__
VENDOR_JWT_REFRESH_SECRET=__GENERATE__

# --- SMTP (OPTIONAL fallback) ---
# Preferred: configure SMTP in the admin Settings UI (stored in system_settings,
# takes precedence over these). Leave blank to manage entirely from the UI.
# secure (implicit TLS) auto-enables when SMTP_PORT=465; STARTTLS on 587 + user.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hadiclinic.com.kw

# --- CAPTCHA (vendor self-registration) — org's real hCaptcha keys ---
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SECRET_KEY=__REAL_HCAPTCHA_SECRET__

# --- Storage (local volumes on /dev/sdb) ---
STORAGE_DRIVER=local

# --- Report worker ---
REPORT_WORKER_ENABLED=true
REPORT_WORKER_CONCURRENCY=2
REPORT_QUEUE_NAME=ctmp-report-exports

# --- Audit chain verifier ---
AUDIT_VERIFY_ON_START=true
AUDIT_VERIFY_LIMIT=1000

# --- Master key for encrypted system_settings (SMTP / AD passwords) ---
# REQUIRED in production. If unset the app uses a known in-source fallback key,
# making stored secrets trivially decryptable. Generate: openssl rand -hex 32.
# Rotating this key requires re-encrypting existing secrets (see handover).
SETTINGS_ENCRYPTION_KEY=__GENERATE__

# --- Public URLs (single origin, port 4202) ---
# ADMIN_PUBLIC_API_URL is baked into the admin bundle at build time; the others
# are used by the API for CORS and for links inside outbound emails.
ADMIN_TLS_PORT=4202
ADMIN_PUBLIC_API_URL=https://ctmp.hadiclinic.com.kw:4202
ADMIN_PORTAL_URL=https://ctmp.hadiclinic.com.kw:4202
CORS_ORIGINS=https://ctmp.hadiclinic.com.kw:4202
# Vendor portal goes live on 172.16.4.11 in a later phase; kept for email links.
VENDOR_PORTAL_URL=https://vn.hadiclinic.com.kw:4201

# --- Active Directory (LOCAL auth only this phase — leave blank) ---
AD_URL=ldap://ad.local:389
AD_BIND_DN=
AD_BIND_PASSWORD=
